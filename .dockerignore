**
!backend/
!backend/**

# Web client source (built in the web-builder stage). Its local install and
# build output are excluded; the image runs npm ci itself.
!web/
!web/**
web/node_modules
web/node_modules/**
web/dist
web/dist/**
web/*.tsbuildinfo

# iroh remote-access bridge (Rust): needed by the iroh-builder stage in
# backend/Dockerfile. Exclude the local build output (target/) — the image
# compiles its own Linux binary.
backend/iroh-host/target
backend/iroh-host/target/**

backend/.git/
backend/.cache
backend/.cache/**
backend/.gocache
backend/.gocache/**
backend/.tmp
backend/.tmp/**
backend/__pycache__
backend/__pycache__/**
backend/bin
backend/bin/**
backend/cache
backend/cache/**
backend/mediastorm
backend/novastream
backend/coverage.out
backend/server.log
backend/*.log
backend/*.tmp
